# =============================================================================
# Vet em Sete — variáveis de ambiente
# Copie para .env.local (desenvolvimento) e cadastre as mesmas na Vercel
# (Project Settings → Environment Variables). Nunca suba o .env.local no Git.
# =============================================================================

# --- Etapa 2 (jogo sem login) ------------------------------------------------
# Segredo para assinar o estado da partida. Qualquer texto aleatório com 32+
# caracteres. Para gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SEGREDO_PARTIDA=

# --- Etapa 3 em diante (login e banco) ---------------------------------------
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave secreta: só no servidor, nunca com prefixo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Domínios de e-mail aceitos no login, separados por vírgula (sem @)
ALLOWED_EMAIL_DOMAINS=unifeob.pro.br,sou.unifeob.edu.br

# E-mails com perfil de professor, separados por vírgula
PROFESSOR_EMAILS=thiago.vargas@unifeob.pro.br

# Nome da instituição usada como padrão
INSTITUICAO_PADRAO=UNIFEOB

# Endereço público do site (usado nos links de login e no texto de compartilhar)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
